n><dqv:QualityAnnotation><dcterms:created>2022-04-21T11:47:55.419703Z</dcterms:created><oa:hasTarget rdf:resource="http://data.europeana.eu/aggregation/provider/739/europeana_fashion_BK_1961_105"/><oa:hasBody rdf:resource="http://www.europeana.eu/schemas/epf/metadataTierA"/></dqv:QualityAnnotation></dqv:hasQualityAnnotation></ore:Aggregation><ore:Proxy rdf:about="http://data.europeana.eu/proxy/europeana/739/europeana_fashion_BK_1961_105"><dc:format rdf:resource="http://data.europeana.eu/concept/2130"></dc:format><dc:format rdf:resource="http://data.europeana.eu/concept/1795"></dc:format><dc:identifier>http://mint-projects.image.ntua.gr/europeana-fashion/BK-1961-105</dc:identifier><dc:language>nld</dc:language><dcterms:created rdf:resource="#1885"></dcterms:created><dcterms:spatial rdf:resource="http://data.europeana.eu/place/1634"></dcterms:spatial><dcterms:spatial rdf:resource="http://data.europeana.eu/place/10626"></dcterms:spatial><dcterms:spatial rdf:resource="http://data.europeana.eu/place/80"></dcterms:spatial><edm:europeanaProxy>true</edm:europeanaProxy><edm:year>1885</edm:year><ore:proxyFor rdf:resource="http://data.europeana.eu/item/739/europeana_fashion_BK_1961_105"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/europeana/739/europeana_fashion_BK_1961_105"/><ore:lineage rdf:resource="http://data.europeana.eu/proxy/provider/739/europeana_fashion_BK_1961_105"/><edm:type>IMAGE</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/739/europeana_fashion_BK_1961_105"><dc:description xml:lang="en">After 1820 most wedding dresses were white, and so this black example is unusual. The bride had her dress made by Wilhelmine Wildermann, a seamstress who owned a shop in one of the well-known main streets of Karlsruhe (Baden-Württemberg). The cut of wedding dresses in this German federal state was always in keeping with fashion. The colour, however, was generally black as women traditionally wore black dresses to church.</dc:description><dc:description xml:lang="nl">Vanaf 1820 worden de meeste trouwjurken wit; deze zwarte is dus ongebruikelijk. De bruid liet haar jurk maken door naaister Wilhelmine Wildermann die een winkel had in een van de grote, bekende winkelstraten van Karlsruhe (Baden-Württemberg). In deze Duitse deelstaat volgde men qua model de mode. De kleur echter was traditiegetrouw zwart, omdat vrouwen in de kerk een zwarte jurk droegen.</dc:description><dc:format xml:lang="en">silk</dc:format><dc:format xml:lang="en">jet (coal)</dc:format><dc:format xml:lang="nl">zijde</dc:format><dc:format xml:lang="nl">kant (materiaal)</dc:format><dc:format xml:lang="nl">git</dc:format><dc:identifier>BK-1961-105</dc:identifier><dc:language>nl</dc:language><dc:title xml:lang="en">Black wedding dress</dc:title><dc:title xml:lang="nl">Zwarte trouwjurk</dc:title><dc:type rdf:resource="http://thesaurus.europeanafashion.eu/thesaurus/10000"></dc:type><dc:type xml:lang="en">Object Type: fashion objects</dc:type><dcterms:created>1885</dcterms:created><dcterms:extent xml:lang="en">geheel length 132 cm</dcterms:extent><dcterms:extent xml:lang="en">geheel length 142 cm</dcterms:extent><dcterms:extent xml:lang="en">geheel waist 62 cm</dcterms:extent><dcterms:extent xml:lang="nl">lengte 132 cm</dcterms:extent><dcterms:extent xml:lang="nl">lengte 142 cm</dcterms:extent><dcterms:extent xml:lang="nl">taille 62 cm</dcterms:extent><dcterms:spatial xml:lang="nl">Karlsruhe</dcterms:spatial><edm:europeanaProxy>false</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/739/europeana_fashion_BK_1961_105"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/provider/739/europeana_fashion_BK_1961_105"/><edm:type>IMAGE</edm:type></ore:Proxy><edm:EuropeanaAggregation rdf:about="http://data.europeana.eu/aggregation/europeana/739/europeana_fashion_BK_1961_105"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/739/europeana_fashion_BK_1961_105"/><edm:datasetName>739_