iotQ0l76Ec5GqwSvPRVT30IjOl8s=s0"/><edm:provider rdf:resource="http://data.europeana.eu/organization/1482250000000369861"></edm:provider><edm:rights rdf:resource="http://creativecommons.org/publicdomain/mark/1.0/"/><dqv:hasQualityAnnotation><dqv:QualityAnnotation><dcterms:created>2022-04-21T11:44:48.547950Z</dcterms:created><oa:hasTarget rdf:resource="http://data.europeana.eu/aggregation/provider/739/europeana_fashion_BK_1973_325"/><oa:hasBody rdf:resource="http://www.europeana.eu/schemas/epf/contentTier4"/></dqv:QualityAnnotation></dqv:hasQualityAnnotation><dqv:hasQualityAnnotation><dqv:QualityAnnotation><dcterms:created>2022-04-21T11:44:48.548725Z</dcterms:created><oa:hasTarget rdf:resource="http://data.europeana.eu/aggregation/provider/739/europeana_fashion_BK_1973_325"/><oa:hasBody rdf:resource="http://www.europeana.eu/schemas/epf/metadataTierB"/></dqv:QualityAnnotation></dqv:hasQualityAnnotation></ore:Aggregation><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/739/europeana_fashion_BK_1973_325"><dc:creator xml:lang="en">anonymous</dc:creator><dc:creator xml:lang="nl">anoniem</dc:creator><dc:creator xml:lang="nl">anoniem</dc:creator><dc:description xml:lang="en">While this gown may look very chic, such chintz frocks were usually worn indoors by upper-class women as négligés (nightgowns). However, it was acceptable as street wear among the middle class. These delicate floral scrolls are also found in Indian export embroidery. The ornament derives from a European copperplate printed cotton.</dc:description><dc:description xml:lang="nl">Deze jurk lijkt heel chic, maar dit soort japonnen van sits werden door vrouwen uit de hogere standen binnenshuis gedragen als négligé (nachtjapon). De burgerij kon zich ook buitenshuis in een japon van sits vertonen. Het ijle ornament van bloemtakken is ook bekend van Indiaas export-borduurwerk. Het is afgeleid van katoenen stoffen die in Europa met behulp van koperplaten werden bedrukt.</dc:description><dc:format xml:lang="en">cotton (textile)</dc:format><dc:format xml:lang="en">linen (material)</dc:format><dc:format xml:lang="en">silk</dc:format><dc:format xml:lang="nl">katoen</dc:format><dc:format xml:lang="nl">linnen</dc:format><dc:format xml:lang="nl">zijde</dc:format><dc:identifier>BK-1973-325</dc:identifier><dc:language>nl</dc:language><dc:title xml:lang="en">Chintz Sack Gown</dc:title><dc:title xml:lang="nl">Jurk van sits</dc:title><dc:type rdf:resource="http://thesaurus.europeanafashion.eu/thesaurus/10000"></dc:type><dc:type xml:lang="en">Object Type: fashion objects</dc:type><dcterms:created>1780</dcterms:created><dcterms:created xml:lang="en">c.1775 - c.1780</dcterms:created><dcterms:created xml:lang="nl">ca.1775 - ca.1780</dcterms:created><dcterms:extent xml:lang="en">geheel length 143.0 cm</dcterms:extent><dcterms:extent xml:lang="en">geheel length 158.0 cm</dcterms:extent><dcterms:extent xml:lang="en">katoen width 0.87 cm</dcterms:extent><dcterms:extent xml:lang="en">rapport length 0.69 cm</dcterms:extent><dcterms:extent xml:lang="en">rapport width 0.87 cm</dcterms:extent><dcterms:extent xml:lang="nl">lengte 143,0 cm</dcterms:extent><dcterms:extent xml:lang="nl">lengte 158,0 cm</dcterms:extent><dcterms:extent xml:lang="nl">breedte 0,87 cm</dcterms:extent><dcterms:extent xml:lang="nl">lengte 0,69 cm</dcterms:extent><dcterms:extent xml:lang="nl">breedte 0,87 cm</dcterms:extent><dcterms:spatial rdf:resource="https://sws.geonames.org/2750405/"></dcterms:spatial><dcterms:spatial rdf:resource="https://sws.geonames.org/1269750/"></dcterms:spatial><edm:europeanaProxy>false</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/739/europeana_fashion_BK_1973_325"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/provider/739/europeana_fashion_BK_1973_325"/><edm:type>IMAGE</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/europeana/739/europeana_fashion_BK_1973_325"><dc:creator rdf:resource="http://data.europeana.e