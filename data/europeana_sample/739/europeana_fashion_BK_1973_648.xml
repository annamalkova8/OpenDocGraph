place/40723"></dcterms:spatial><dcterms:spatial rdf:resource="http://data.europeana.eu/place/106"></dcterms:spatial><edm:europeanaProxy>true</edm:europeanaProxy><edm:year>1808</edm:year><ore:proxyFor rdf:resource="http://data.europeana.eu/item/739/europeana_fashion_BK_1973_648"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/europeana/739/europeana_fashion_BK_1973_648"/><ore:lineage rdf:resource="http://data.europeana.eu/proxy/provider/739/europeana_fashion_BK_1973_648"/><edm:type>IMAGE</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/739/europeana_fashion_BK_1973_648"><dc:creator xml:lang="en">anonymous</dc:creator><dc:creator xml:lang="en">anonymous</dc:creator><dc:creator xml:lang="en">anonymous</dc:creator><dc:creator xml:lang="nl">anoniem</dc:creator><dc:creator xml:lang="nl">anoniem</dc:creator><dc:creator xml:lang="nl">anoniem</dc:creator><dc:description xml:lang="nl">Beugeltas in ovale vorm, van goudbrokaat met roze en bruin patroon van vogels, bloemen en bladeren. Tussen de twee panden een strook stof van hetzelfde materiaal, net als het korte hengsel, dat de vorm heeft van een lus. De tas heeft een verguld zilveren beugel in een halfronde vorm met een gladde bovenkant en zijkanten met gleuven in reliëf. Bovenop een knipsluiting. De tas is gevoerd met oranjeroze changeant zijde en heeft een extra vak met een enkele vergulden beugel. tegen de buitenste beugel een lint van gouddraad.</dc:description><dc:format xml:lang="en">silk</dc:format><dc:format xml:lang="en">silver (metal)</dc:format><dc:format xml:lang="en">silk</dc:format><dc:format xml:lang="en">gilding (material)</dc:format><dc:format xml:lang="nl">zijde</dc:format><dc:format xml:lang="nl">zilver</dc:format><dc:format xml:lang="nl">zijde</dc:format><dc:format xml:lang="nl">gouddraad</dc:format><dc:format xml:lang="nl">verguldsel</dc:format><dc:identifier>BK-1973-648</dc:identifier><dc:language>nl</dc:language><dc:title xml:lang="nl">Beugeltas in ovale vorm, van goudbrokaat met roze en bruin patroon van vogels en bloemen, aan een verguld zilveren beugel met knipsluiting</dc:title><dc:type rdf:resource="http://thesaurus.europeanafashion.eu/thesaurus/10000"></dc:type><dc:type xml:lang="en">Object Type: fashion objects</dc:type><dcterms:created>1808</dcterms:created><dcterms:created xml:lang="en">c.1890 - c.1920</dcterms:created><dcterms:created xml:lang="nl">ca.1890 - ca.1920</dcterms:created><dcterms:extent xml:lang="en">geheel length 12.3 cm</dcterms:extent><dcterms:extent xml:lang="en">geheel width 14 cm</dcterms:extent><dcterms:extent xml:lang="en">geheel thickness 2 cm</dcterms:extent><dcterms:extent xml:lang="nl">lengte 12,3 cm</dcterms:extent><dcterms:extent xml:lang="nl">breedte 14 cm</dcterms:extent><dcterms:extent xml:lang="nl">dikte 2 cm</dcterms:extent><dcterms:spatial rdf:resource="https://sws.geonames.org/9408659/"></dcterms:spatial><dcterms:spatial rdf:resource="https://sws.geonames.org/2755251/"></dcterms:spatial><dcterms:spatial rdf:resource="https://sws.geonames.org/2750405/"></dcterms:spatial><dcterms:spatial xml:lang="en">Eastern Asia</dcterms:spatial><dcterms:spatial xml:lang="nl">Oost-Azië</dcterms:spatial><edm:europeanaProxy>false</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/739/europeana_fashion_BK_1973_648"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/provider/739/europeana_fashion_BK_1973_648"/><edm:type>IMAGE</edm:type></ore:Proxy><edm:EuropeanaAggregation rdf:about="http://data.europeana.eu/aggregation/europeana/739/europeana_fashion_BK_1973_648"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/739/europeana_fashion_BK_1973_648"/><edm:datasetName>739_EuropeanaFashion_1121</edm:datasetName><edm:country>Netherlands</edm:country><edm:preview rdf:resource="https://lh6.ggpht.com/IqzwOP4cQH4anSd7s7tWvYOPcgJX4Uqq1dBKeIGFLYMpZYO6kQZpcySsMje0ZwBjeMZlY6KczAwpy1a8gKIcGZ20FUNP=s0"/><edm:landingPage rdf:resource="https://www.europe