fLabel><skos:prefLabel xml:lang="pt">joalharia</skos:prefLabel><skos:prefLabel xml:lang="el">κόσμημα</skos:prefLabel><skos:prefLabel xml:lang="en">jewelry</skos:prefLabel><skos:prefLabel xml:lang="it">gioiello</skos:prefLabel><skos:prefLabel xml:lang="fr">bijoux</skos:prefLabel><skos:prefLabel xml:lang="he">תכשיטים</skos:prefLabel><skos:prefLabel xml:lang="es">joyería</skos:prefLabel><skos:prefLabel xml:lang="nl">sieraad</skos:prefLabel><skos:prefLabel xml:lang="sr">nakit</skos:prefLabel><skos:note xml:lang="en">Ornaments such as bracelets, necklaces, and rings, of precious or semiprecious materials worn or carried on the person for adornment; also includes similar articles worn or carried for devotional or mourning purposes. (AAT)</skos:note><skos:broader rdf:resource="http://thesaurus.europeanafashion.eu/thesaurus/10150"/><skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300209286"/><skos:inScheme rdf:resource="http://thesaurus.europeanafashion.eu/thesaurus/Type"/><skos:inScheme rdf:resource="http://thesaurus.europeanafashion.eu/thesaurus/Subject"/></skos:Concept><ore:Aggregation rdf:about="http://data.europeana.eu/aggregation/provider/739/europeana_fashion_AK_MAK_1307"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/739/europeana_fashion_AK_MAK_1307"/><edm:dataProvider rdf:resource="http://data.europeana.eu/organization/1482250000000338795"></edm:dataProvider><edm:isShownAt rdf:resource="http://hdl.handle.net/10934/RM0001.COLLECT.2018"/><edm:isShownBy rdf:resource="https://lh4.ggpht.com/KkoZj2vgBQ2V3EKD-ZTxeoF66NEjtziIrTADBY2h1oFP1apPxRcxxbFE_jwGtfGzWQdKV65k6DX2NiQmPVeozK1hsQE=s0"/><edm:provider rdf:resource="http://data.europeana.eu/organization/1482250000000369861"></edm:provider><edm:rights rdf:resource="http://creativecommons.org/publicdomain/mark/1.0/"/><dqv:hasQualityAnnotation><dqv:QualityAnnotation><dcterms:created>2022-04-21T11:46:49.966260Z</dcterms:created><oa:hasTarget rdf:resource="http://data.europeana.eu/aggregation/provider/739/europeana_fashion_AK_MAK_1307"/><oa:hasBody rdf:resource="http://www.europeana.eu/schemas/epf/contentTier4"/></dqv:QualityAnnotation></dqv:hasQualityAnnotation><dqv:hasQualityAnnotation><dqv:QualityAnnotation><dcterms:created>2022-04-21T11:46:49.966678Z</dcterms:created><oa:hasTarget rdf:resource="http://data.europeana.eu/aggregation/provider/739/europeana_fashion_AK_MAK_1307"/><oa:hasBody rdf:resource="http://www.europeana.eu/schemas/epf/metadataTierC"/></dqv:QualityAnnotation></dqv:hasQualityAnnotation></ore:Aggregation><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/739/europeana_fashion_AK_MAK_1307"><dc:creator xml:lang="en">anonymous</dc:creator><dc:creator xml:lang="nl">anoniem</dc:creator><dc:description xml:lang="en">These two intricately worked ornaments differ greatly in character. The necklace consists of sixteen hollow ‘tiger claw’ pendants mounted on little tubes for frontal display. The chain is made of interlocking gold links and is therefore highly flexible. It features a bud or fruit pendant at one end and an open flower at the other.</dc:description><dc:description xml:lang="nl">Deze twee minutieus bewerkte sieraden zijn heel verschillend in karakter. De ketting bestaat uit zestien holle ‘tijgerklauwhangers’ aan buisjes, zodat zij frontaal gezien kunnen worden. Het koordsieraad is gemaakt van in elkaar hakende gouden schakeltjes, en is daardoor zeer flexibel. Aan het ene uiteinde zit een knop of vrucht, aan het andere een open bloem.</dc:description><dc:format xml:lang="en">gold (metal)</dc:format><dc:format xml:lang="nl">goud</dc:format><dc:identifier>AK-MAK-1307</dc:identifier><dc:language>nl</dc:language><dc:title xml:lang="en">Necklace and Decorative Chain with Terminals</dc:title><dc:title xml:lang="nl">Ketting en koordsieraad met hangers</dc:title><dc:type rdf:resource="http://thesaurus.europeanafashion.eu/thesaurus/10152"></dc:type><dc:type xml:lang="en">Object Type: jewelry</dc:type><dcterms:created xml:lang="en">c.900 - c.1000</dcterms:created><dcterms:created xml:lang="nl">ca.900 - ca.1000</dcterms:created><dcterms:extent xml:lang="en">length 29 cm</dcterms:extent><dcterms:extent xml:lang="en">width 18 cm</dcterms:extent><dcterms:extent xml:lang="en">height 15 cm</dcterms:extent><dcterms:extent xml:lang="en">weight 34.84 gr</dcterms:extent><dcterms:extent xml:lang="nl">lengte 29 cm</dcterms:extent><dcterms:extent xml:lang="nl">breedte 18 cm</dcterms:extent><dcterms:extent xml:lang="nl">hoogte 15 cm</dcterms:extent><dcterms:extent xml:lang="nl">gewicht 34,84 gr</dcterms:extent><dcterms:provenance xml:lang="nl">from Mrs Jelske Wagenaar-Terpstra, Amsterdam, fl. 6,750, to the Vereniging van Vrienden der Aziatische Kunst, 1979;{Note RMA.} from whom on loan to the museum, 1979</dcterms:provenance><dcterms:spatial rdf:resource="https://sws.geonames.org/1643084/"></dcterms:spatial><edm:europeanaProxy>false</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/739/europeana_fashion_AK_MAK_1307"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/provider/739/europeana_fashion_AK_MAK_1307"/><edm:type>IMAGE</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/europeana/739/europeana_fashion_AK_MAK_1307"><dc:creator rdf:resource="http://data.europeana.eu/agent/65916"></dc:creator><dc:format rdf:resource="http://data.europeana.eu/concept/1771"></dc:format><dc:identifier>http://mint-projects.image.ntua.gr/europeana-fashion/AK-MAK-1307</dc:identifier><dc:language>nld</dc:language><dc:type rdf:resource="http://data.europeana.eu/concept/41"></dc:type><dcterms:spatial rdf:resource="http://data.europeana.eu/place/216267"></dcterms:spatial><edm:europeanaProxy>true</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/739/europeana_fashion_AK_MAK_1307"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/europeana/739/europeana_fashion_AK_MAK_1307"/><ore:lineage rdf:resource="http://data.europeana.eu/proxy/pr