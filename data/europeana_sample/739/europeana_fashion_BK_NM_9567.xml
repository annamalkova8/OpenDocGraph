a.eu/agent/65916"></dc:creator><dc:format rdf:resource="http://data.europeana.eu/concept/1771"></dc:format><dc:identifier>http://mint-projects.image.ntua.gr/europeana-fashion/BK-NM-9567</dc:identifier><dc:language>nld</dc:language><dc:type rdf:resource="http://data.europeana.eu/concept/41"></dc:type><dcterms:created rdf:resource="#1535"></dcterms:created><dcterms:spatial rdf:resource="http://data.europeana.eu/place/80"></dcterms:spatial><edm:europeanaProxy>true</edm:europeanaProxy><edm:year>1535</edm:year><ore:proxyFor rdf:resource="http://data.europeana.eu/item/739/europeana_fashion_BK_NM_9567"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/europeana/739/europeana_fashion_BK_NM_9567"/><ore:lineage rdf:resource="http://data.europeana.eu/proxy/provider/739/europeana_fashion_BK_NM_9567"/><edm:type>IMAGE</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/739/europeana_fashion_BK_NM_9567"><dc:creator xml:lang="en">anonymous</dc:creator><dc:creator xml:lang="en">rejected attribution anonymous</dc:creator><dc:creator xml:lang="nl">anoniem</dc:creator><dc:creator xml:lang="nl">verworpen toeschrijving anoniem</dc:creator><dc:description xml:lang="en">In the 16th century, seals were sometimes made of rock crystal. The transparency of this stone made it possible to include a coat of arms both in relief and in colour (on the back of the stone). The one here – three black wheels with five spokes in a field of silver – belongs to the Van Wijnbergens, a noble family from the province of Overijssel. Accordingly, this ring was most likely made in the northern Netherlands.</dc:description><dc:description xml:lang="nl">In de 16de eeuw werden zegels soms in bergkristal uitgevoerd. De doorzichtige steen maakte het mogelijk om het wapen zowel in reliëf als in kleur aan te brengen (achter op de steen). Het wapen zelf, drie zwarte wielen met vijf spaken in een veld van zilver, is dat van het Overijsselse adellijke geslacht Van Wijnbergen. Daarom is het aannemelijk dat deze ring in de Noordelijke Nederlanden is vervaardigd.</dc:description><dc:format xml:lang="en">gold (metal)</dc:format><dc:format xml:lang="nl">goud</dc:format><dc:format xml:lang="nl">bergkristal</dc:format><dc:identifier>BK-NM-9567</dc:identifier><dc:language>nl</dc:language><dc:title xml:lang="en">Signet ring with the Van Wijnbergen family arms</dc:title><dc:title xml:lang="nl">Zegelring met het familiewapen van Van Wijnbergen</dc:title><dc:type rdf:resource="http://thesaurus.europeanafashion.eu/thesaurus/10152"></dc:type><dc:type xml:lang="en">Object Type: jewelry</dc:type><dcterms:created>1535</dcterms:created><dcterms:extent xml:lang="en">diameter 3.0 cm</dcterms:extent><dcterms:extent xml:lang="nl">diameter 3,0 cm</dcterms:extent><dcterms:spatial rdf:resource="https://sws.geonames.org/2921044/"></dcterms:spatial><dcterms:spatial xml:lang="en">Northern Netherlands</dcterms:spatial><dcterms:spatial xml:lang="nl">Noordelijke Nederlanden</dcterms:spatial><edm:europeanaProxy>false</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/739/europeana_fashion_BK_NM_9567"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/provider/739/europeana_fashion_BK_NM_9567"/><edm:type>IMAGE</edm:type></ore:Proxy><edm:EuropeanaAggregation rdf:about="http://data.europeana.eu/aggregation/europeana/739/europeana_fashion_BK_NM_9567"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/739/europeana_fashion_BK_NM_9567"/><edm:datasetName>739_EuropeanaFashion_1121</edm:datasetName><edm:country>Netherlands</edm:country><edm:preview rdf:resource="https://lh3.ggpht.com/dXmVxeuRLMqP8A5ON1duuB4Q9JLJv1Q9qLjDfJfZeuOb2RJMlclYTDixYR_oWkvY9u_Gvfp6LbLYxG762s8U80sAGOmE=s0"/><edm:landingPage rdf:resource="https://www.europeana.eu/item/739/europeana_fashion_BK_NM_9567"/><edm:language>nl</edm:language><edm:completeness>0</edm:completeness><dcterms:created>2022-04-21T11:41:12.945Z</dcterms:created><dcterms:modified>2022-04