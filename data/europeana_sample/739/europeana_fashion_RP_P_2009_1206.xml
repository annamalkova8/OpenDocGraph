1206"/><oa:hasBody rdf:resource="http://www.europeana.eu/schemas/epf/metadataTierB"/></dqv:QualityAnnotation></dqv:hasQualityAnnotation></ore:Aggregation><ore:Proxy rdf:about="http://data.europeana.eu/proxy/europeana/739/europeana_fashion_RP_P_2009_1206"><dc:format rdf:resource="http://data.europeana.eu/concept/2090"></dc:format><dc:identifier>http://mint-projects.image.ntua.gr/europeana-fashion/RP-P-2009-1206</dc:identifier><dc:language>nld</dc:language><dcterms:created rdf:resource="#1785"></dcterms:created><dcterms:spatial rdf:resource="http://data.europeana.eu/place/41488"></dcterms:spatial><dcterms:spatial rdf:resource="http://data.europeana.eu/place/42377"></dcterms:spatial><dcterms:spatial rdf:resource="http://data.europeana.eu/place/85"></dcterms:spatial><edm:europeanaProxy>true</edm:europeanaProxy><edm:year>1785</edm:year><ore:proxyFor rdf:resource="http://data.europeana.eu/item/739/europeana_fashion_RP_P_2009_1206"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/europeana/739/europeana_fashion_RP_P_2009_1206"/><ore:lineage rdf:resource="http://data.europeana.eu/proxy/provider/739/europeana_fashion_RP_P_2009_1206"/><edm:type>IMAGE</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/739/europeana_fashion_RP_P_2009_1206"><dc:creator xml:lang="nl">toegeschreven aan </dc:creator><dc:description xml:lang="en">In 1778 two young publishers tapped a previously undiscovered market with the launch of a series entitled Gallerie des Modes, which responded to the growing demand among Parisians for fashion news. Initially featuring only hairstyles, the series’ illustrations were later extended to include complete outfits to cater to its audience. These showed figures from head to toe. All ranks of French society were represented in a wide variety of fashionable clothes, from the simple negligée 1 to the robe à la polonaise 2 3, the robe à l’anglaise 4 and the occasional smart gentleman’s suit.</dc:description><dc:description xml:lang="nl">In 1778 zagen twee jonge uitgevers een gat in de markt. Als antwoord op de groeiende vraag van Parijzenaars naar modenieuws gaven zij de serie Gallerie des Modes uit. In het begin omvatte deze reeks uitsluitend kapsels, maar omdat het publiek de complete outfit wilde zien werden de illustraties aangepast. Deze toonden nu figuren van top tot teen. Alle lagen van de Franse bevolking komen voorbij in een grote verscheidenheid aan modieuze kleren: van het eenvoudige negligé 1 tot de robe à la polonaise 2 3, de robe à l’anglaise 4 en een enkel modieus mannenkostuum.</dc:description><dc:format xml:lang="en">paper</dc:format><dc:format xml:lang="nl">papier</dc:format><dc:identifier>RP-P-2009-1206</dc:identifier><dc:language>nl</dc:language><dc:subject xml:lang="nl">1785 - 1785</dc:subject><dc:title xml:lang="en">Gallerie des Modes</dc:title><dc:title xml:lang="nl">Gallerie des Modes</dc:title><dc:type rdf:resource="http://thesaurus.europeanafashion.eu/thesaurus/10000"></dc:type><dc:type xml:lang="en">Object Type: fashion objects</dc:type><dcterms:created>1785</dcterms:created><dcterms:extent xml:lang="en">plaatrand height 290 mm</dcterms:extent><dcterms:extent xml:lang="en">plaatrand width 207 mm</dcterms:extent><dcterms:extent xml:lang="nl">hoogte 290 mm</dcterms:extent><dcterms:extent xml:lang="nl">breedte 207 mm</dcterms:extent><dcterms:spatial rdf:resource="https://sws.geonames.org/2988507/"></dcterms:spatial><edm:europeanaProxy>false</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/739/europeana_fashion_RP_P_2009_1206"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/provider/739/europeana_fashion_RP_P_2009_1206"/><edm:type>IMAGE</edm:type></ore:Proxy><edm:EuropeanaAggregation rdf:about="http://data.europeana.eu/aggregation/europeana/739/europeana_fashion_RP_P_2009_1206"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/739/europeana_fashion_RP_P_2009_1206"/><edm:datasetName>739_EuropeanaFashio