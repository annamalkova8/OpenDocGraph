ider><edm:rights rdf:resource="http://creativecommons.org/publicdomain/mark/1.0/"/><dqv:hasQualityAnnotation><dqv:QualityAnnotation><dcterms:created>2022-04-21T11:44:30.636402Z</dcterms:created><oa:hasTarget rdf:resource="http://data.europeana.eu/aggregation/provider/739/europeana_fashion_BK_NM_13145_B"/><oa:hasBody rdf:resource="http://www.europeana.eu/schemas/epf/contentTier4"/></dqv:QualityAnnotation></dqv:hasQualityAnnotation><dqv:hasQualityAnnotation><dqv:QualityAnnotation><dcterms:created>2022-04-21T11:44:30.636755Z</dcterms:created><oa:hasTarget rdf:resource="http://data.europeana.eu/aggregation/provider/739/europeana_fashion_BK_NM_13145_B"/><oa:hasBody rdf:resource="http://www.europeana.eu/schemas/epf/metadataTierA"/></dqv:QualityAnnotation></dqv:hasQualityAnnotation></ore:Aggregation><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/739/europeana_fashion_BK_NM_13145_B"><dc:description xml:lang="en">These flat, silk shoes were very delicate; they were usually ruined after just a single night’s dancing. To protect shoes from the dust, mud and stones on the unpaved roads, overshoes were worn with a metal platform under the sole. China was traditionally the greatest producer of silk. After a Dutch East India Company trading post was established in Canton (1728), silk shoes were also exported to Europe.</dc:description><dc:description xml:lang="nl">Deze platte zijden schoentjes waren erg kwetsbaar: na één avond dansen waren ze meestal versleten. Om
de schoenen te beschermen tegen het stof, de modder en de stenen op de onverharde wegen droeg men overschoenen met een metalen verhoging onder de zool. China was van oudsher de grootste producent van zijde. Na de oprichting van een VOC-handelspost in Kanton (1728) werden ook zijden schoenen naar Europa geëxporteerd.</dc:description><dc:format xml:lang="en">silk</dc:format><dc:format xml:lang="en">silver thread</dc:format><dc:format xml:lang="en">silver (metal)</dc:format><dc:format xml:lang="en">silk</dc:format><dc:format xml:lang="en">linen (material)</dc:format><dc:format xml:lang="en">linen (material)</dc:format><dc:format xml:lang="nl">zijde</dc:format><dc:format xml:lang="nl">rips</dc:format><dc:format xml:lang="nl">zilverdraad</dc:format><dc:format xml:lang="nl">zilver</dc:format><dc:format xml:lang="nl">zijde</dc:format><dc:format xml:lang="nl">linnen</dc:format><dc:format xml:lang="nl">linnen</dc:format><dc:format xml:lang="nl">runderleer</dc:format><dc:identifier>BK-NM-13145-B</dc:identifier><dc:language>nl</dc:language><dc:title xml:lang="en">Pair of ladies’ shoes</dc:title><dc:title xml:lang="nl">Paar damesschoenen</dc:title><dc:type rdf:resource="http://thesaurus.europeanafashion.eu/thesaurus/10000"></dc:type><dc:type xml:lang="en">Object Type: fashion objects</dc:type><dcterms:created xml:lang="en">c.1790 - c.1815</dcterms:created><dcterms:created xml:lang="nl">ca.1790 - ca.1815</dcterms:created><dcterms:extent xml:lang="en">geheel length 24.8 cm</dcterms:extent><dcterms:extent xml:lang="en">geheel width 5.9 cm</dcterms:extent><dcterms:extent xml:lang="en">hak height 1 cm</dcterms:extent><dcterms:extent xml:lang="nl">lengte 24,8 cm</dcterms:extent><dcterms:extent xml:lang="nl">breedte 5,9 cm</dcterms:extent><dcterms:extent xml:lang="nl">hoogte 1 cm</dcterms:extent><dcterms:spatial xml:lang="nl">Kanton</dcterms:spatial><edm:europeanaProxy>false</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/739/europeana_fashion_BK_NM_13145