 rdf:resource="http://data.europeana.eu/concept/2090"></dcterms:medium><dcterms:spatial rdf:resource="http://data.europeana.eu/organization/4373"></dcterms:spatial><dcterms:temporal rdf:resource="http://data.europeana.eu/timespan/16"></dcterms:temporal><edm:europeanaProxy>true</edm:europeanaProxy><edm:year>1563</edm:year><ore:proxyFor rdf:resource="http://data.europeana.eu/item/1200/058_RP_13"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/europeana/1200/058_RP_13"/><ore:lineage rdf:resource="http://data.europeana.eu/proxy/provider/1200/058_RP_13"/><edm:type>TEXT</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/1200/058_RP_13"><dc:creator>Platon</dc:creator><dc:creator rdf:resource="http://viaf.org/viaf/108159964"></dc:creator><dc:date>1563</dc:date><dc:description xml:lang="en">In the midst of the religious wars, the authors looked for ways to deal with religious conflicts. For some of them, Greek thought was a fundamental source for finding a solution to the conflicts. This was the case of Loys Le Roy (1510-1577), a renowned Hellenist of his time, who looked to the ancient wisdom of Plato, Aristotle and Demosthenes for a political way out of the religious wars.</dc:description><dc:format xml:lang="en">Printing</dc:format><dc:identifier>NUMM-8712079</dc:identifier><dc:language>Greek</dc:language><dc:subject rdf:resource="http://www.wikidata.org/entity/Q684281"></dc:subject><dc:subject rdf:resource="http://www.wikidata.org/entity/Q859"></dc:subject><dc:subject xml:lang="en">Loys Le Roy</dc:subject><dc:subject xml:lang="en">Plato</dc:subject><dc:title xml:lang="en">Loys Le Roy  translation of Plato Discours treselegat &amp; tresgrave sur le Royaume des Perses</dc:title><dcterms:isPartOf xml:lang="en">GrECI</dcterms:isPartOf><dcterms:medium xml:lang="en">Paper</dcterms:medium><dcterms:provenance xml:lang="en">Bibliothèque nationale de France</dcterms:provenance><dcterms:spatial rdf:resource="https://sws.geonames.org