b.eu/getImage.php?id=274&amp;w=2500&amp;h=1875&amp;c=0&amp;co=1&amp;f=0&amp;t=0&amp;.jpg"/><edm:provider rdf:resource="http://data.europeana.eu/organization/1613"></edm:provider><edm:rights rdf:resource="http://creativecommons.org/licenses/by/4.0/"/><edm:intermediateProvider>MUSEU_HUB</edm:intermediateProvider><dqv:hasQualityAnnotation><dqv:QualityAnnotation><dcterms:created>2024-08-20T17:10:34.736510252Z</dcterms:created><oa:hasTarget rdf:resource="http://data.europeana.eu/aggregation/provider/1200/037a_Id_12"/><oa:hasBody rdf:resource="http://www.europeana.eu/schemas/epf/contentTier4"/></dqv:QualityAnnotation></dqv:hasQualityAnnotation><dqv:hasQualityAnnotation><dqv:QualityAnnotation><dcterms:created>2024-08-20T17:10:34.736521533Z</dcterms:created><oa:hasTarget rdf:resource="http://data.europeana.eu/aggregation/provider/1200/037a_Id_12"/><oa:hasBody rdf:resource="http://www.europeana.eu/schemas/epf/metadataTierC"/></dqv:QualityAnnotation></dqv:hasQualityAnnotation></ore:Aggregation><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/1200/037a_Id_12"><dc:creator>Manno Sbarri</dc:creator><dc:creator>Giovanni Bernardi</dc:creator><dc:creator rdf:resource="http://viaf.org/viaf/38317659"></dc:creator><dc:creator rdf:resource="http://viaf.org/viaf/32797151"></dc:creator><dc:date>1548-1561</dc:date><dc:description xml:lang="en">This elaborate coffin was commissioned by Cardinal Alessandro Farnese and is notable for its rich iconographic programme and numerous Greek and Latin inscriptions. Three Greek inscriptions show mottoes of the Farnese, namely "Lily of Justice", emblem of Paul III; "Strike like this", inspired by Hom., Il. 21.282 to symbolise Farnese's ability to get to the heart of things; and "We have sailed beyond", invented by the Cardinal's former secretary, Annibal Caro, on the model of Orphic Argonautics (vv. 733, 1271). The allusion to this text, which was widely circulated in humanist Italy, shows Caro's erudite taste.</dc:description><dc:format x