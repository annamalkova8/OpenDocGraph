ww.europeana.eu/schemas/epf/contentTier4"/></dqv:QualityAnnotation></dqv:hasQualityAnnotation><dqv:hasQualityAnnotation><dqv:QualityAnnotation><dcterms:created>2024-08-20T17:10:37.316924489Z</dcterms:created><oa:hasTarget rdf:resource="http://data.europeana.eu/aggregation/provider/1200/055_RP_10"/><oa:hasBody rdf:resource="http://www.europeana.eu/schemas/epf/metadataTierC"/></dqv:QualityAnnotation></dqv:hasQualityAnnotation></ore:Aggregation><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/1200/055_RP_10"><dc:creator>Nicolai Alphonsi de Bobadilla</dc:creator><dc:creator rdf:resource="http://viaf.org/viaf/95853815"></dc:creator><dc:date>1913</dc:date><dc:description xml:lang="en">Knowledge of Greek was common to both humanists and religious innovators, whether within Catholicism or among the reformers who were breaking away from the denominations. Working on biblical texts thanks to knowledge of Greek challenged traditional interpretations of the Bible. As a result, knowledge of Greek was suspected of heresy by the theologians at the Sorbonne, and students were advised against it, as shown here in the text by the Jesuit Nicolas Bobadilla.</dc:description><dc:format xml:lang="en">Printed text</dc:format><dc:language>Greek</dc:language><dc:subject rdf:resource="http://www.wikidata.org/entity/Q2711040"></dc:subject><dc:subject rdf:resource="http://www.wikidata.org/entity/Q36380"></dc:subject><dc:subject xml:lang="en">Nicolaus Alphonsus Bobadilla</dc:subject><dc:subject xml:lang="en">Jesuits</dc:subject><dc:title xml:lang="en">Fragment of Bobadillae Monumentae</dc:title><dcterms:isPartOf xml:lang="en">GrECI</dcterms:isPartOf><dcterms:medium xml:lang="en">Paper</dcterms:medium><dcterms:provenance xml:lang="en">HathiTrust</dcterms:provenance><dcterms:temporal rdf:resource="http://www.wikidata.org/entity/Q6927"></dcterms:temporal><edm:europeanaProxy>false</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/1200/055_RP_10"/><ore:proxyIn