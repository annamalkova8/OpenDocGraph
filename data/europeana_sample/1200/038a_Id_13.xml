9"/><skos:broader rdf:resource="http://www.wikidata.org/entity/Q32880"/><skos:broader rdf:resource="http://www.wikidata.org/entity/Q1292119"/><skos:broader rdf:resource="http://www.wikidata.org/entity/Q2198855"/><skos:exactMatch rdf:resource="https://www.freebase.com/m/03mgmk"/><skos:exactMatch rdf:resource="https://g.co/kg/m/03mgmk"/><skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300252246"/><skos:exactMatch rdf:resource="http://dbpedia.org/resource/Northern_Renaissance"/><skos:related rdf:resource="http://www.wikidata.org/entity/Q4692"/></skos:Concept><ore:Aggregation rdf:about="http://data.europeana.eu/aggregation/provider/1200/038a_Id_13"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/1200/038a_Id_13"/><edm:dataProvider rdf:resource="http://data.europeana.eu/organization/4328"></edm:dataProvider><edm:isShownAt rdf:resource="http://www.museuhub.eu/en/65/graeci-project/1023/portrait-medal-of-adolph-occo-iii"/><edm:isShownBy rdf:resource="http://www.museuhub.eu/getImage.php?id=263&amp;w=2500&amp;h=1875&amp;c=0&amp;co=1&amp;f=0&amp;t=0&amp;.jpg"/><edm:provider rdf:resource="http://data.europeana.eu/organization/1613"></edm:provider><edm:rights rdf:resource="http://creativecommons.org/licenses/by/4.0/"/><edm:intermediateProvider>MUSEU_HUB</edm:intermediateProvider><dqv:hasQualityAnnotation><dqv:QualityAnnotation><dcterms:created>2024-08-20T17:10:36.799540925Z</dcterms:created><oa:hasTarget rdf:resource="http://data.europeana.eu/aggregation/provider/1200/038a_Id_13"/><oa:hasBody rdf:resource="http://www.europeana.eu/schemas/epf/contentTier4"/></dqv:QualityAnnotation></dqv:hasQualityAnnotation><dqv:hasQualityAnnotation><dqv:QualityAnnotation><dcterms:created>2024-08-20T17:10:36.799558313Z</dcterms:created><oa:hasTarget rdf:resource="http://data.europeana.eu/aggregation/provider/1200/038a_Id_13"/><oa:hasBody rdf:resource="http://www.europeana.eu/schemas/epf/metadataTierC"/></dqv:QualityAnnotation></dqv:hasQualityAnnotation></ore:Aggregation><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/1200/038a_Id_13"><dc:creator>Adolph Occo III</dc:creator><dc:creator rdf:resource="http://viaf.org/viaf/268955446"></dc:creator><dc:date>ca. 1553</dc:date><dc:description xml:lang="en">Like his father, Adolph Occo III practised medicine in Augsburg and had a medal portrait with many Greek elements. On the obverse his portrait is accompanied by an inscription identifying him as 'Adolf's son, doctor in the 3rd generation, 28 years old'. On the reverse, the Greek text around the edge is a quotation from Wisdom of Sol 7:6 ("For there is but one way in and one way out for everyone"), while the inscription on the cube-shaped table reproduces Revelation 2:10 ("Be faithful until death"). The medal is an example of how the Greek language was used to express religious identity and affiliation.</dc:description><dc:format xml:lang="en">Casting</dc:format><dc:identifier>Inv. 11-0286</dc:identifier><dc:language>Greek</dc:language><dc:language>Latin</dc:language><dc:subject rdf:resource="http://www.wikidata.org/wiki/Q23902138"></dc:subject><dc:subject rdf:resource="http://www.wikidata.org/entity/Q610877"></dc:subject><dc:subject xml:lang="en">Adolph Occo III</dc:subject><dc:subject xml:lang="en">Northern Renaissance</dc:subject><dc:title xml:lang="en">Portrait medal of Adolph Occo III</dc:title><dcterms:isPartOf xml:lang="en">GrECI</dcterms:isPartOf><dcterms:medium xml:lang="en">Lead</dcterms:medium><dcterms:provenance xml:lang="en">Munich, Staatliche Münzsammlung</dcterms:provenance><dcterms:spatial rdf:resource="https://sws.geonames.org/10279201/"></dcterms:spatial><dcterms:temporal rdf:resource="http://www.wikidata.org/entity/Q7017"></dcterms:temporal><edm:europeanaProxy>false</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/1200/038a_Id_13"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/provider/1200/038a_Id_13"/><edm:type>IMAGE</edm:type></ore:Proxy><ore:Proxy rdf:about=