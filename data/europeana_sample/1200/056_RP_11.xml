ate><dc:description xml:lang="en">Religious tension increased in France throughout the 16th century. Although in a minority, the Reformation won over a section of the population and important figures within the nobility. Religious conflicts followed one another, culminating in 8 civil wars between 1562 and 1598. The massacre at Vassy, where Protestants were attacked by the troops of the Catholic Duke of Guise, was the starting point for these conflicts.</dc:description><dc:format xml:lang="en">Engraving</dc:format><dc:language>Greek</dc:language><dc:language>Latin</dc:language><dc:subject rdf:resource="http://www.wikidata.org/entity/Q1086489"></dc:subject><dc:subject rdf:resource="http://www.wikidata.org/entity/Q673175"></dc:subject><dc:subject xml:lang="en">Massacre of Vassy</dc:subject><dc:subject xml:lang="en">French wars of religion</dc:subject><dc:title xml:lang="en">Image of the Massacre in Vassy</dc:title><dcterms:isPartOf xml:lang="en">GrECI</dcterms:isPartOf><dcterms:medium xml:lang="en">Paper</dcterms:medium><dcterms:provenance xml:lang="en">Chateau de Pau</dcterms:provenance><dcterms:spatial rdf:resource="https://sws.geonames.org/12495714/"></dcterms:spatial><dcterms:temporal rdf:resource="http://www.wikidata.org/entity/Q7017"></dcterms:temporal><edm:europeanaProxy>false</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/1200/056_RP_11"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/provider/1200/056_RP_11"/><edm:type>IMAGE</edm:type></ore:Proxy><edm:EuropeanaAggregation rdf:about="http://data.europeana.eu/aggregation/europeana/1200/056_RP_11"><edm:aggregatedCHO rdf:resource="http://data.europeana.eu/item/1200/056_RP_11"/><edm:datasetName>1200_University_of_Cyprus</edm:datasetName><edm:country>Cyprus</edm:country><edm:preview rdf:resource="http://www.museuhub.eu/getImage.php?id=283&amp;w=2500&amp;h=1875&amp;c=0&amp;co=1&amp;f=0&amp;t=0&amp;.jpg"/><edm:landingPage rdf:resource="https://www.europeana.eu/item/1200