on></dqv:hasQualityAnnotation></ore:Aggregation><ore:Proxy rdf:about="http://data.europeana.eu/proxy/europeana/1200/035a_Id_10"><dc:date rdf:resource="#1536%2F1537"></dc:date><dc:identifier>035a_Id_10</dc:identifier><dc:language>ell</dc:language><dcterms:temporal rdf:resource="http://data.europeana.eu/timespan/16"></dcterms:temporal><edm:europeanaProxy>true</edm:europeanaProxy><ore:proxyFor rdf:resource="http://data.europeana.eu/item/1200/035a_Id_10"/><ore:proxyIn rdf:resource="http://data.europeana.eu/aggregation/europeana/1200/035a_Id_10"/><ore:lineage rdf:resource="http://data.europeana.eu/proxy/provider/1200/035a_Id_10"/><edm:type>IMAGE</edm:type></ore:Proxy><ore:Proxy rdf:about="http://data.europeana.eu/proxy/provider/1200/035a_Id_10"><dc:creator>Agnolo di Cosimo di Marino (Bronzino)</dc:creator><dc:creator rdf:resource="http://viaf.org/viaf/102323982"></dc:creator><dc:date>1536-1537</dc:date><dc:description xml:lang="en">The painting illustrates how ancient Greek texts could contribute to the creation of a cultured identity among the young aristocrats of the Italian city-states. The book in front of the sitter is a copy of Homer's Iliad, opened to the beginning of Book 9. The painting also contains a copy of Virgil and shows Ugolino's left arm resting on a work by Pietro Bembo, suggesting that the young nobleman had received (or was receiving) a thorough classical and literary education.</dc:description><dc:format xml:lang="en">Painting</dc:format><dc:identifier>Inv. 338A</dc:identifier><dc:language>Greek</dc:language><dc:subject rdf:resource="http://www.wikidata.org/entity/Q1283023"></dc:subject><dc:subject rdf:resource="http://www.wikidata.org/entity/Q2914470"></dc:subject><dc:subject rdf:resource="http://www.wikidata.org/entity/Q1404472"></dc:subject><dc:subject xml:lang="en">Ugolino Martelli</dc:subject><dc:subject xml:lang="en">Italian Renaissance</dc:subject><dc:subject xml:lang="en">Italian Renaissance painting</dc:subject><dc:title xml:lang="en">Portra